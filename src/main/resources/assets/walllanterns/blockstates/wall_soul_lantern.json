{
  "multipart": [
    {
      "when": {
        "OR": [
          {
            "facing": "north"
          },
          {
            "facing": "south"
          },
          {
            "facing": "east"
          },
          {
            "facing": "west"
          }
        ]
      },
      "apply": {
        "model": "minecraft:block/soul_lantern"
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "walllanterns:block/wall_lantern_holder"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "walllanterns:block/wall_lantern_holder",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "walllanterns:block/wall_lantern_holder",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "walllanterns:block/wall_lantern_holder",
        "y": 270
      }
    }
  ]
}